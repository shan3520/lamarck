{
  "harness_dir": "harness",
  "tasks": "tasks.calibrated.json",
  "requests_per_minute": 20,
  "target": {
    "type": "command",
    "harness_file": "AGENT.md",
    "timeout": 2400,
    "agent_cmd": "{python} -m lamarck.agents.mini --provider nvidia --model nvidia/nemotron-3-super-120b-a12b --prompt-file {prompt_file} --max-steps 25 --max-tokens-total 80000 --rpm 9"
  },
  "proposer": {
    "type": "llm",
    "provider": "groq",
    "model": "openai/gpt-oss-120b",
    "effort": "medium",
    "n_proposals": 1
  },
  "evolve": {
    "iterations": 6,
    "proposals_per_iter": 1,
    "k_screen": 2,
    "k_confirm": 4,
    "k_heldout": 4,
    "workers": 2,
    "max_total_tokens": 12000000
  },
  "gate": {}
}



